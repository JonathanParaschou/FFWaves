# Required for online rooms on Vercel. Connect Redis from Vercel Storage.
# Use the integration's native TCP/TLS connection URL; do not put it in dist/.
REDIS_URL=
# Optional separate-server mode only. Leave blank for Vercel's included endpoint.
MATCHMAKING_URL=
# Optional separate-server origin allowlist (not needed for same-site Vercel).
ALLOWED_ORIGINS=
MAX_ROOMS=8
